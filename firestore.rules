rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'stharunindu@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /projects/{project} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /messages/{message} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /siteContent/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pageViews/{view} {
      allow create: if request.resource.data.keys().hasOnly(['path', 'timestamp'])
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 120;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
